# App
APP_ENV=development
APP_NAME=AI Investment Advisor
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Single-user auth (local / personal deploy)
APP_USERNAME=juan
APP_PASSWORD=change-me
APP_SECRET_KEY=change-me-to-a-long-random-string
# Leave empty locally. Set in Render + Cloudflare + GitHub Actions.
APP_API_KEY=

# Database (local Docker Compose)
DATABASE_URL=postgresql+psycopg://advisor:advisor@localhost:5433/ai_investment_advisor

# LLM — local (LM Studio) or cloud free tiers
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model

# Optional cloud fallbacks (Render)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Market data
FRED_API_KEY=
MARKET_LOOKBACK_DAYS=365

# Email (Gmail SMTP) — use Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your.email@gmail.com
EMAIL_TO=your.email@gmail.com
EMAIL_NOTIFY_ON_RUN=true

# Investor defaults
BASE_CURRENCY=USD
RISK_PROFILE=aggressive
ALLOCATION_CONSERVATIVE_PCT=40
ALLOCATION_MODERATE_PCT=40
ALLOCATION_AGGRESSIVE_PCT=20
AVAILABLE_CAPITAL_USD=10000
